                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"jsonrpc\": \"string\",\n  \"id\": 2536,\n  \"result\": \"\",\n  \"error\": {\n    \"code\": 9170,\n    \"message\": \"string\",\n    \"data\": \"\"\n  }\n}",
